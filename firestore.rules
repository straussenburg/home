rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Jede Person darf ausschließlich ihr eigenes Dokument lesen und
    // schreiben. Die Dokument-ID ist die von Firebase Authentication
    // vergebene, nicht vorhersehbare Nutzer-Kennung (uid) – niemand kann
    // durch Erraten einer ID auf die Daten einer anderen Person zugreifen.
    match /students/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Alles andere ist gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
